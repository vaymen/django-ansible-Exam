# Managed by Ansible - do not edit.
# "$" is doubled because Compose interpolates env_file values.
DJANGO_SECRET_KEY={{ django_secret_key | replace('$', '$$') }}
DJANGO_DEBUG={{ app_debug | lower }}
DJANGO_ALLOWED_HOSTS={{ app_allowed_hosts }}
APP_VERSION={{ app_version }}
WEB_CONCURRENCY={{ app_workers }}
DB_HOST=db
DB_PORT=5432
DB_NAME={{ db_name }}
DB_USER={{ db_user }}
DB_PASSWORD={{ db_password | replace('$', '$$') }}
